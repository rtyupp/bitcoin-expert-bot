[Unit]
Description=Bitcoin Expert Telegram Bot (polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/bitcoin-expert-bot
EnvironmentFile=/etc/bitcoin-expert-bot.env
ExecStart=/opt/bitcoin-expert-bot/.venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
